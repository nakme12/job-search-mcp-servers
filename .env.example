# Copy this file's values into your own MCP client config (see README "Connecting to Claude").
# Do NOT commit a real .env with filled-in secrets to this repo.

# --- Adzuna (adzuna-jobs-server.js) ---
# Get both from https://developer.adzuna.com/ -> sign up -> dashboard shows
# "Application ID" (app_id) and "Application Keys" (create new key = app_key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- HireBase (hirebase-jobs-server.js) ---
# Get from https://www.hirebase.org/signup -> create free account (no card)
# -> Profile menu -> API Key
HIREBASE_API_KEY=

# --- JobsPipe (jobspipe-jobs-server.js) ---
# Get from https://jobspipe.dev/signup -> free tier = 100 credits/month
# Key is shown in your dashboard, starts with "jp_live_"
JOBSPIPE_API_KEY=

# --- TheirStack (theirstack-jobs-server.js) ---
# Get from https://theirstack.com/ -> sign up -> free tier = 200 credits/month
# Account settings -> API key (or skip this and use TheirStack's OAuth login instead, see README)
THEIRSTACK_API_KEY=

# --- career-site-jobs (career-site-jobs-server.js, Apify) ---
# Get from https://apify.com/ -> sign up -> Settings -> Integrations -> API tokens
# NOTE: this one is billed (~$4 per 1000 jobs); Apify gives ~$5 free credit/month
APIFY_API_TOKEN=

# --- Google Jobs / SerpApi (google-jobs-server.js) ---
# Get from https://serpapi.com/ -> sign up (no card) -> dashboard shows your private API key
# Free tier = 250 searches/month. Aggregates LinkedIn, Indeed, career pages and more.
SERPAPI_API_KEY=

# --- The Muse (themuse-jobs-server.js) --- OPTIONAL
# Works with no key at 500 req/hr. Register at https://www.themuse.com/developers/api/v2
# for 3600 req/hr and set the key here.
THEMUSE_API_KEY=

# --- No key needed, work out of the box ---
# huntyourtribe-jobs-server.js
# ashby-jobs-server.js      (pass a company's Ashby slug, e.g. "notion")
# remotive-jobs-server.js
# remoteok-jobs-server.js
