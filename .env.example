# ==============================================================================
# JOB SEARCH MCP ENGINE - ENVIRONMENT VARIABLES & API CONFIGURATION
# ==============================================================================
# Copy this file to .env in your root directory:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. LIVE CANDIDATE INFORMATION (Auto-filled into applications & emails)
# ------------------------------------------------------------------------------
CANDIDATE_NAME="Pratik Patidar"
CANDIDATE_EMAIL="pratikpatidar7990@gmail.com"
CANDIDATE_PHONE="+91 82696 47990"
CANDIDATE_LOCATION="Indore, Madhya Pradesh, India"
CANDIDATE_LINKEDIN="https://www.linkedin.com/in/pratik-patidar"
CANDIDATE_PORTFOLIO="https://pratik-portfolio-nine-orcin.vercel.app"
CANDIDATE_GITHUB="https://github.com/pratikpatidar"
CANDIDATE_YOE="1.5"

# ------------------------------------------------------------------------------
# 2. BROWSER & CHROME CDP DEBUGGING CONFIGURATION
# ------------------------------------------------------------------------------
# Port on which Chrome runs with remote debugging enabled
CDP_PORT=9222
CDP_HOST="127.0.0.1"

# ------------------------------------------------------------------------------
# 3. JOB SEARCH & AGGREGATOR MCP SERVER API KEYS (Optional for Live ATS)
# ------------------------------------------------------------------------------
# Adzuna API (Get free key: https://developer.adzuna.com/)
ADZUNA_APP_ID="your_adzuna_app_id_here"
ADZUNA_API_KEY="your_adzuna_api_key_here"

# The Muse API Key (Get key: https://www.themuse.com/developers/api/v2)
THE_MUSE_API_KEY="your_themuse_api_key_here"

# Apify Token (For Career Site Aggregator / Scraping)
APIFY_TOKEN="your_apify_token_here"

# TheirStack API Key
THEIRSTACK_API_KEY="your_theirstack_api_key_here"

# DevITjobs API Key
DEVITJOBS_API_KEY="your_devitjobs_api_key_here"

# Jooble API Key
JOOBLE_API_KEY="your_jooble_api_key_here"

# Careerjet API Key
CAREERJET_AFFID="your_careerjet_affid_here"

# ------------------------------------------------------------------------------
# 4. DISPATCH SAFETY & ANTI-BOT RATE LIMITS
# ------------------------------------------------------------------------------
EMAIL_DISPATCH_COOLDOWN_MS=60000     # 60 seconds anti-spam human cooldown
PORTAL_SUBMIT_COOLDOWN_MS=20000     # 20 seconds portal form cooldown
MAX_DAILY_APPLICATION_FLOOR=50      # Daily minimum application target
